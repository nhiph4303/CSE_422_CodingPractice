@model IEnumerable<DeviceManagementSystem.Models.DeviceCategory>

@{
	ViewData["Title"] = "Device Categories";
}

@* Thông báo Thành công *@
@if (TempData["Success"] != null)
{
	<div id="toast-success"
		 class="fixed top-6 right-6 z-50 bg-green-600 text-white
                px-6 py-3 rounded-xl shadow-lg flex items-center gap-3 animate-bounce">
		<span class="material-symbols-outlined">check_circle</span>
		<span>@TempData["Success"]</span>
	</div>
	<script>setTimeout(() => document.getElementById('toast-success')?.remove(), 3000);</script>
}

@* Thông báo Lỗi *@
@if (TempData["Error"] != null)
{
	<div id="toast-error"
		 class="fixed top-6 right-6 z-50 bg-red-600 text-white
                px-6 py-3 rounded-xl shadow-lg flex items-center gap-3 animate-bounce">
		<span class="material-symbols-outlined">error</span>
		<span>@TempData["Error"]</span>
	</div>
	<script>setTimeout(() => document.getElementById('toast-error')?.remove(), 3000);</script>
}

@* BREADCRUMB *@
<div class="mb-6">
	<div class="flex items-center gap-2 text-sm font-medium text-slate-500">
		<a asp-controller="Home" asp-action="Index" class="hover:text-primary">Home</a>
		<span>/</span>
		<span class="text-slate-900 font-semibold">Device Categories</span>
	</div>
</div>

<div class="w-full">

	@* HEADER & SEARCH *@
	<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
		<div>
			<h1 class="text-3xl font-black">Device Categories</h1>
			<p class="text-slate-500">
				Manage hardware types and their default configurations.
			</p>
		</div>

		<a asp-action="Create"
		   class="bg-primary text-white px-5 py-2.5 rounded-lg font-bold shadow flex items-center gap-2 hover:bg-primary-hover transition">
			<span class="material-symbols-outlined text-[20px]">add</span>
			Add New Category
		</a>
	</div>

	<div class="mb-8">
		<form method="get" asp-action="Index" class="relative w-full md:max-w-md">
			<input type="text"
				   name="search"
				   value="@ViewBag.Search"
				   placeholder="Search categories..."
				   class="w-full rounded-lg py-2.5 pl-4 pr-10 border focus:ring-2 focus:ring-primary focus:outline-none" />
			<button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary">
				<span class="material-symbols-outlined">search</span>
			</button>
		</form>
	</div>

	@* DANH SÁCH *@
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
		@foreach (var item in Model)
		{
			<div class="bg-white rounded-xl p-6 border shadow flex flex-col justify-between hover:shadow-lg transition">
				<div>
					<div class="mb-4">
						<div class="size-14 rounded-2xl bg-blue-50 text-primary flex items-center justify-center">
							<span class="material-symbols-outlined text-3xl">category</span>
						</div>
					</div>

					<h3 class="text-lg font-bold mb-1">@item.Name</h3>
					<p class="text-sm text-slate-500">Device category</p>
				</div>

				<div class="flex items-center justify-between pt-4 mt-6 border-t">
					<span class="text-xs font-bold text-primary">
						@(item.Devices?.Count ?? 0) Devices
					</span>

					<div class="flex gap-1">
						@* Nút Edit *@
						<a asp-action="Edit" asp-route-id="@item.Id"
						   class="p-2 hover:bg-slate-100 rounded text-slate-600">
							<span class="material-symbols-outlined text-[18px]">edit</span>
						</a>

						@* Nút Delete (Đã sửa thành Button gọi Modal) *@
						<button type="button"
								onclick="openDeleteModal(@item.Id, '@item.Name')"
								class="p-2 hover:bg-red-50 text-red-500 rounded transition-colors">
							<span class="material-symbols-outlined text-[18px]">delete</span>
						</button>
					</div>
				</div>
			</div>
		}

		@* Card Thêm mới (Cuối danh sách) *@
		<a asp-action="Create"
		   class="bg-slate-50 rounded-xl p-6 border-2 border-dashed
                  flex flex-col items-center justify-center min-h-[240px] hover:border-primary hover:bg-blue-50/50 transition cursor-pointer group">

			<div class="size-16 rounded-full bg-white flex items-center justify-center mb-4 group-hover:scale-110 transition">
				<span class="material-symbols-outlined text-primary text-3xl">add</span>
			</div>

			<h3 class="font-bold text-slate-700 group-hover:text-primary">Add New Category</h3>
			<p class="text-sm text-slate-500">Create a new hardware grouping</p>
		</a>
	</div>
</div>

@* DELETE MODAL (POPUP XÓA) *@
<div id="deleteModal"
	 class="fixed inset-0 bg-black/40 hidden
            items-center justify-center z-50 backdrop-blur-sm transition-opacity">

	<div class="bg-white rounded-xl p-6 w-full max-w-md shadow-2xl transform transition-all scale-100">
		<h2 class="text-lg font-black text-red-600 mb-2 flex items-center gap-2">
			<span class="material-symbols-outlined">warning</span>
			Delete Category
		</h2>

		<p class="text-slate-600 mb-4">
			Are you sure you want to delete this category? This action cannot be undone.
		</p>

		<div class="bg-red-50 p-3 rounded mb-6 text-sm border border-red-100">
			<b>Category:</b> <span id="deleteCategoryName" class="text-red-700"></span>
		</div>

		
		<form method="post" asp-action="Delete">
			@Html.AntiForgeryToken()
			<input type="hidden" name="id" id="deleteCategoryId" />

			<div class="flex justify-end gap-3">
				<button type="button"
						onclick="closeDeleteModal()"
						class="px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 font-bold text-slate-600 transition">
					Cancel
				</button>

				<button type="submit"
						class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold shadow-lg shadow-red-200 transition">
					Yes, Delete
				</button>
			</div>
		</form>
	</div>
</div>

<script>
	function openDeleteModal(id, name) {
		document.getElementById('deleteCategoryId').value = id;
		document.getElementById('deleteCategoryName').innerText = name;
		document.getElementById('deleteModal').classList.remove('hidden');
		document.getElementById('deleteModal').classList.add('flex');
	}

	function closeDeleteModal() {
		document.getElementById('deleteModal').classList.add('hidden');
		document.getElementById('deleteModal').classList.remove('flex');
	}

	document.getElementById('deleteModal').addEventListener('click', function (e) {
		if (e.target === this) {
			closeDeleteModal();
		}
	});
</script>