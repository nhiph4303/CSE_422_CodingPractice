@model IEnumerable<DeviceManagementSystem.Models.User>

@{
    ViewData["Title"] = "User Management";
}

@if (TempData["Success"] != null)
{
    <div id="toast-success" class="fixed top-6 right-6 z-50 bg-emerald-600 text-white px-6 py-3 rounded-xl shadow-lg flex items-center gap-3 animate-bounce">
        <span class="material-symbols-outlined">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
    <script>setTimeout(() => document.getElementById('toast-success')?.remove(), 3000);</script>
}

<div class="flex flex-col gap-6">
    <div class="flex flex-col">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">User Management</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Manage employees and administrators.</p>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-slate-800 p-2 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <form asp-action="Index" method="get" class="relative w-full sm:w-96 group">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="material-symbols-outlined text-slate-400 group-focus-within:text-blue-600 transition-colors">search</span>
            </div>
            <input type="text" name="search" value="@ViewData["CurrentFilter"]"
                   class="block w-full pl-10 pr-3 py-2.5 border-none rounded-lg bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder-slate-400 focus:ring-2 focus:ring-blue-600/20 focus:bg-white transition-all text-sm font-medium"
                   placeholder="Search user..." />
        </form>

        <a asp-action="Create" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-bold shadow-lg shadow-blue-600/20 transition-all hover:-translate-y-0.5 active:translate-y-0">
            <span class="material-symbols-outlined text-[20px]">add</span>
            <span>Add User</span>
        </a>
    </div>
</div>

<div class="mt-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/30 border-b border-slate-200 dark:border-slate-700">
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">User Details</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Contact Info</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Role</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="p-10 text-center text-slate-500">No users found.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="group hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold border border-blue-200">
                                    @(string.IsNullOrEmpty(item.FullName) ? "?" : item.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-slate-900 dark:text-white">@item.FullName</p>
                                    <p class="text-xs text-slate-500">ID: #USR-@item.Id</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col gap-1">
                                <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">mail</span> @item.Email
                                </div>
                                <div class="flex items-center gap-2 text-xs text-slate-500">
                                    <span class="material-symbols-outlined text-[14px]">call</span> @item.PhoneNumber
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            @if (item.Role == DeviceManagementSystem.Models.UserRole.Admin)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700 border border-purple-200 dark:bg-purple-900/30 dark:text-purple-300 dark:border-purple-800">
                                    <span class="material-symbols-outlined text-[14px]">verified_user</span> Admin
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:border-blue-800">
                                    <span class="material-symbols-outlined text-[14px]">badge</span> Employee
                                </span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors"><span class="material-symbols-outlined text-[20px]">edit</span></a>
                                <button onclick="openDeleteModal(@item.Id, '@item.FullName')" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors"><span class="material-symbols-outlined text-[20px]">delete</span></button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@* Delete Modal *@
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white dark:bg-slate-800 w-full max-w-sm mx-4 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 p-6">
        <div class="flex flex-col items-center text-center mb-6">
            <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mb-4"><span class="material-symbols-outlined text-red-600 dark:text-red-400 text-2xl">delete</span></div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Delete User?</h3>
            <p class="text-sm text-slate-500 mt-2 px-4">Are you sure you want to delete <b id="userNameDisplay"></b>?</p>
        </div>
        <form asp-action="Delete" method="post" class="flex gap-3">
            <input type="hidden" name="id" id="userIdInput" />
            <button type="button" onclick="closeModal()" class="flex-1 px-4 py-2.5 rounded-lg border border-slate-200 dark:border-slate-600 font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50">Cancel</button>
            <button type="submit" class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold shadow-lg shadow-red-600/20">Yes, Delete</button>
        </form>
    </div>
</div>
<script>
    function openDeleteModal(id, name) { document.getElementById('userIdInput').value = id; document.getElementById('userNameDisplay').innerText = name; document.getElementById('deleteModal').classList.remove('hidden'); document.getElementById('deleteModal').classList.add('flex'); }
    function closeModal() { document.getElementById('deleteModal').classList.add('hidden'); document.getElementById('deleteModal').classList.remove('flex'); }
</script>