@model IEnumerable<DeviceManagementSystem.Models.Device>

@{
	ViewData["Title"] = "Device Management";
}

@* success *@
@if (TempData["Success"] != null)
{
	<div id="toast-success"
		 class="fixed top-6 right-6 z-50 bg-green-600 text-white
                px-6 py-3 rounded-xl shadow-lg flex items-center gap-3">
		<span class="material-symbols-outlined">check_circle</span>
		<span>@TempData["Success"]</span>
	</div>

	<script>
		setTimeout(() => {
			document.getElementById('toast-success')?.remove();
		}, 3000);
	</script>
}

@* breadcrum *@
<div class="mb-6">
	<div class="flex items-center gap-2 text-sm font-medium text-slate-500">
		<a asp-controller="Home" asp-action="Index" class="hover:text-primary">
			Home
		</a>
		<span>/</span>
		<span class="text-slate-900 font-semibold">Devices</span>
	</div>
</div>

@* header *@
<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
	<div>
		<h1 class="text-3xl font-black">Device Management</h1>
		<p class="text-slate-500">Track hardware inventory and status</p>
	</div>

	<a asp-action="Create"
	   class="bg-primary hover:bg-primary-hover text-white
              px-5 py-2.5 rounded-lg font-bold shadow">
		+ Add Device
	</a>
</div>

@* search & filter *@
<form method="get" asp-action="Index"
	  class="bg-white rounded-xl border shadow p-4 mb-6">

	<div class="grid grid-cols-1 md:grid-cols-4 gap-4">

		@* search *@
		<input type="text"
			   name="search"
			   value="@ViewBag.Search"
			   placeholder="Search by device name or code..."
			   class="border rounded-lg px-4 py-2 w-full" />

		@* filter status *@
		<select name="status"
				asp-items="ViewBag.StatusList"
				class="border rounded-lg px-4 py-2 w-full">
			<option value="">-- All Status --</option>
		</select>

		@* filter category *@
		<select name="categoryId"
				asp-items="ViewBag.Categories"
				class="border rounded-lg px-4 py-2 w-full">
			<option value="">-- All Categories --</option>
		</select>

		@* action button *@
		<div class="flex gap-2">
			<button type="submit"
					class="bg-primary text-white px-4 py-2 rounded-lg font-bold w-full">
				Filter
			</button>

			<a asp-action="Index"
			   class="px-4 py-2 rounded-lg bg-slate-200 font-bold text-center w-full">
				Reset
			</a>
		</div>

	</div>
</form>

@* <table *@
<div class="bg-white rounded-xl shadow border overflow-x-auto">
	<table class="w-full text-left">
		<thead class="bg-slate-50 border-b">
			<tr>
				<th class="p-4">Device Name</th>
				<th class="p-4">Code</th>
				<th class="p-4">Category</th>
				<th class="p-4">Status</th>
				<th class="p-4">Date</th>
				<th class="p-4 text-right">Actions</th>
			</tr>
		</thead>

		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="6"
						class="text-center py-10 text-slate-500">
						No devices found.
					</td>
				</tr>
			}
			else
			{
				foreach (var d in Model)
				{
					<tr class="border-b hover:bg-slate-50">
						<td class="p-4 font-bold">@d.DeviceName</td>
						<td class="p-4 font-mono">@d.DeviceCode</td>
						<td class="p-4">@d.DeviceCategory?.Name</td>

						<td class="p-4">
							@if (d.Status == DeviceManagementSystem.Models.DeviceStatus.Active)
							{
								<span class="px-2 py-1 rounded text-xs font-bold
                                             bg-green-100 text-green-700">
									In Use
								</span>
							}
							else if (d.Status == DeviceManagementSystem.Models.DeviceStatus.Maintenance)
							{
								<span class="px-2 py-1 rounded text-xs font-bold
                                             bg-yellow-100 text-yellow-700">
									Under Maintenance
								</span>
							}
							else
							{
								<span class="px-2 py-1 rounded text-xs font-bold
                                             bg-red-100 text-red-700">
									Broken
								</span>
							}
						</td>

						<td class="p-4">
							@d.DateOfEntry.ToString("dd/MM/yyyy")
						</td>

						<td class="p-4 text-right whitespace-nowrap">
							<a asp-action="Edit"
							   asp-route-id="@d.Id"
							   class="text-blue-600 font-bold mr-3">
								Edit
							</a>

							@* delete button *@
							<button type="button"
									onclick="openDeleteModal(@d.Id, '@d.DeviceName')"
									class="text-red-600 font-bold">
								Delete
							</button>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>

@* delete *@
<div id="deleteModal"
	 class="fixed inset-0 bg-black/40 hidden
            items-center justify-center z-50">

	<div class="bg-white rounded-xl p-6 w-full max-w-md shadow-lg">
		<h2 class="text-lg font-black text-red-600 mb-2">
			Delete Device
		</h2>

		<p class="text-slate-600 mb-4">
			Are you sure you want to delete this device?
		</p>

		<div class="bg-slate-50 p-3 rounded mb-4 text-sm">
			<b>Device:</b> <span id="deleteDeviceName"></span>
		</div>

		<form method="post" asp-action="DeleteConfirmed">
			@Html.AntiForgeryToken()
			<input type="hidden" name="id" id="deleteDeviceId" />

			<div class="flex justify-end gap-3">
				<button type="button"
						onclick="closeDeleteModal()"
						class="px-4 py-2 rounded bg-slate-200">
					No
				</button>

				<button type="submit"
						class="px-4 py-2 rounded bg-red-600 text-white font-bold">
					Yes, Delete
				</button>
			</div>
		</form>
	</div>
</div>

@* js *@
<script>
	function openDeleteModal(id, name) {
		document.getElementById('deleteDeviceId').value = id;
		document.getElementById('deleteDeviceName').innerText = name;
		document.getElementById('deleteModal').classList.remove('hidden');
		document.getElementById('deleteModal').classList.add('flex');
	}

	function closeDeleteModal() {
		document.getElementById('deleteModal').classList.add('hidden');
		document.getElementById('deleteModal').classList.remove('flex');
	}
</script>
